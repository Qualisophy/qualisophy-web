---
import { getLangFromUrl } from '../i18n/ui';

const { class: className } = Astro.props;

// Obtenemos los segmentos de la URL
let paths = Astro.url.pathname.split("/").filter(Boolean);

// 1. Detectar el idioma actual usando la función que ya tienes
const currentLang = getLangFromUrl(Astro.url);

// Filtrar los prefijos de idioma ('es' o 'fr') de las rutas 
// para que no aparezcan como un paso en el Breadcrumb (ej. Inicio / fr / Cours)
paths = paths.filter(path => path !== 'es' && path !== 'fr');

// 2. Mapa de rutas estructurado por idioma
const routeNameMap: Record<string, Record<string, string>> = {
  es: {
    // Main routes
    "corporate-training": "Formación Empresas",
    "cursos": "Cursos",
    "partnership": "Partnership",
    "contact": "Contacto",
    "talent-inclusion": "Inclusión Laboral",
    "faq": "Preguntas Frecuentes",
    "course-enrollment": "Matriculación",
    "team": "Equipo",
    "blog": "Blog",

    // Categories
    "desarrollo": "Desarrollo",
    "qa": "QA & Testing",
    "data": "Data & BI",
    "herramientas": "Herramientas Empresariales",
    "devops": "DevOps & Gestión",
    "agile": "Agile & Scrum",

    // Specific Courses
    "calidad-software": "Calidad de Software (QA) y Testing",
    "pruebas-api": "API Testing con Postman",
    "bootcamp-cypress": "Cypress Automation Bootcamp",
    "pruebas-junit": "Tests Unitarios con JUnit",
    "pruebas-agiles": "Agile Testing",
    "pruebas-ia-generativa": "Generative AI para Software Testing",
    "sql-powerbi": "Introducción a SQL para PowerBI",
    "analitica-powerbi": "Analítica de Datos con Power BI",
    "excel-experto": "Microsoft Excel Expert",
    "ofimatica-integral": "Ofimática Integral",
    "chatbots": "Chatbots para E-commerce",
    "productividad-make": "Productividad con Make",
    "git": "Control de Versiones con Git",
    "gitlab-cicd": "Gestión Avanzada y CI/CD con GitLab",
    "introduccion-devops": "DevOps, Continuous Testing y CI/CD",
    "scrum-master": "Agile Mastery: El Camino del Scrum Master",

    // Blog Articles
    "impacto-ia-testing": "Impacto IA Testing",
    "neurodivergencia-ventaja": "Neurodivergencia Ventaja",
    "caso-exito-maria": "Caso Éxito María",
    "powerbi-negocios": "PowerBI Negocios",
    "diversidad-equipos-agiles": "Diversidad Equipos Ágiles",
  },
  
  fr: {
    // Main routes
    "corporate-training": "Formations d'Entreprise",
    "cursos": "Cours",
    "partnership": "Partenariats",
    "contact": "Contact",
    "talent-inclusion": "Inclusion Professionnelle",
    "faq": "Questions Fréquentes",
    "course-enrollment": "Inscription",
    "team": "Équipe",
    "blog": "Blog",

    // Categories
    "desarrollo": "Développement",
    "qa": "QA & Testing",
    "data": "Data & BI",
    "herramientas": "Outils d'Entreprise",
    "devops": "DevOps & Gestion",
    "agile": "Agile & Scrum",

    // Specific Courses
    "calidad-software": "Qualité Logicielle (QA) et Testing",
    "pruebas-api": "Tests API avec Postman",
    "bootcamp-cypress": "Cypress Automation Bootcamp",
    "pruebas-junit": "Tests Unitaires avec JUnit",
    "pruebas-agiles": "Agile Testing",
    "pruebas-ia-generativa": "IA Générative pour le Software Testing",
    "sql-powerbi": "Introduction à SQL pour PowerBI",
    "analitica-powerbi": "Analyse de Données avec Power BI",
    "excel-experto": "Microsoft Excel Expert",
    "ofimatica-integral": "Bureautique Intégrale",
    "chatbots": "Chatbots pour E-commerce",
    "productividad-make": "Productivité avec Make",
    "git": "Contrôle de Version avec Git",
    "gitlab-cicd": "Gestion Avancée et CI/CD avec GitLab",
    "introduccion-devops": "DevOps, Continuous Testing et CI/CD",
    "scrum-master": "Agile Mastery: El Chemin du Scrum Master",

    // Blog Articles
    "impacto-ia-testing": "Impact IA Testing",
    "neurodivergencia-ventaja": "Neurodivergence Avantage",
    "caso-exito-maria": "Cas de Succès Maria",
    "powerbi-negocios": "PowerBI Affaires",
    "diversidad-equipos-agiles": "Diversité Équipes Agiles",
  }
};

// 3. Modificar la función para que reciba el idioma (lang)
const formatName = (slug: string, lang: string) => {
  const normalizedSlug = slug.toLowerCase();

  // 1. Prioridad absoluta: Idioma actual
  if (routeNameMap[lang] && routeNameMap[lang][normalizedSlug]) {
    return routeNameMap[lang][normalizedSlug];
  }

  // 2. Solo si no existe en el actual Y el actual no es español, buscamos en español
  if (lang !== 'es' && routeNameMap['es'] && routeNameMap['es'][normalizedSlug]) {
    return routeNameMap['es'][normalizedSlug];
  }

  // 3. Formateo por defecto (limpieza de slug)
  return slug
    .replace(/-/g, " ")
    .replace(/\b\w/g, (l) => l.toUpperCase())
    .replace(/Powerbi/g, "PowerBI");
};

let accumulatePath = "";
---

<nav
  aria-label="Breadcrumb"
  class:list={["text-sm text-slate-500 w-full", className]}
>
  <ol class="list-none p-0 inline-flex items-center flex-wrap gap-2">
    {/* Home */}
    <li class="flex items-center">
      <a
        href="/"
        class="hover:text-primary transition-colors flex items-center gap-1"
        aria-label="Ir al inicio"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
          ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
        >
      </a>
    </li>

    {/* 🔄 AUTOMATIC GENERATION */}
    {
      paths.map((path, index) => {
        // Acumulamos la ruta manteniendo el prefijo de idioma si existe
        accumulatePath += `/${path}`;
        
        const isLast = index === paths.length - 1;
        // 4. Pasamos el idioma actual detectado a la función de formateo
        const name = formatName(path, currentLang);

        return (
          <li class="flex items-center">
            {/* Separator */}
            <span class="text-slate-400 mx-2">/</span>

            {isLast ? (
              <span class="text-secondary font-medium" aria-current="page">
                {name}
              </span>
            ) : (
              <a
                href={accumulatePath}
                class="hover:text-primary transition-colors"
              >
                {name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>