---
import Layout from "@/layouts/Layout.astro";
import { NeurodivergenceContent } from "@/components/react/programs/NeurodivergenceContent";

// Extraemos los metadatos de la cabecera
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout 
  title={t("neuro.meta.title")}
  description={t("neuro.meta.desc")}
  fullWidth={true}
>
  {/* Cargamos todo el contenido como un único bloque interactivo */}
  <NeurodivergenceContent client:load />
</Layout>