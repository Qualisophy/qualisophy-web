---
import Layout from "@/layouts/Layout.astro";
import { CourseEnrollmentForm } from "@/components/react/course/CourseEnrollmentForm";
import { InstructorCard } from "@/components/react/course/InstructorCard";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

import { getCursos, getCurso, datosInscripcion } from "@/lib/cursos";

// Obtener ID del curso y TIPO de la URL
const url = new URL(Astro.request.url);
const courseId = url.searchParams.get("course") || "";
const enrollmentType = url.searchParams.get("type") || "enrollment"; // 'enrollment' o 'interest'

// Cursos B2B (corporate-training): fuera de la fuente única de cursos B2C (ver QUAL-523)
interface CursoB2B {
  id: string;
  name: string;
  description: string;
  image: string;
  startDate: string;
  duration: string;
  modality: string;
  price: string;
  priceSubtext?: string;
  previousPrice?: string;
  formerStudentDiscount?: string;
  categoryUrl?: string;
  categoryName?: string;
  courseUrl?: string;
}
const cursosB2B: Record<string, CursoB2B> = {
  "enterprise-frontend": { id: "enterprise-frontend", name: "Curso Frontend Moderno", description: "Domina React, Vue y las últimas tecnologías frontend.", image: "https://images.unsplash.com/photo-1610563166150-b34df4f3bcd6?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "447 €" },
  "enterprise-backend": { id: "enterprise-backend", name: "Curso Backend Escalable", description: "Aprende a construir APIs robustas y escalables.", image: "https://images.unsplash.com/photo-1559526324-593bc073d938?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "525 €" },
  "enterprise-fullstack": { id: "enterprise-fullstack", name: "Curso Full Stack Development", description: "Conviértete en desarrollador Full Stack completo.", image: "https://images.unsplash.com/photo-1519241047957-be31d7379a5d?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "597 €" },
  "enterprise-automation": { id: "enterprise-automation", name: "Automatización QA", description: "Automatiza pruebas con las mejores herramientas del mercado.", image: "https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "547 €" },
  "enterprise-devops": { id: "enterprise-devops", name: "DevOps para QA", description: "Integra DevOps en tu proceso de testing.", image: "https://images.unsplash.com/photo-1618401471353-b98afee0b2eb?auto=format&fit=crop&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "547 €" },
  "enterprise-quality": { id: "enterprise-quality", name: "Gestión de Calidad del Software", description: "Gestiona la calidad en proyectos empresariales.", image: "https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "497 €" },
  "enterprise-dashboards": { id: "enterprise-dashboards", name: "Dashboards y Visualización", description: "Crea dashboards impactantes con Power BI.", image: "https://images.unsplash.com/photo-1526628953301-3e589a6a8b74?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "497 €" },
  "enterprise-analytics": { id: "enterprise-analytics", name: "Data Analytics Fundamentals", description: "Fundamentos de análisis de datos empresariales.", image: "https://images.unsplash.com/photo-1640158615573-cd28feb1bf4e?auto=format&fit=crop&w=1470&q=80", startDate: "A consultar", duration: "Personalizable", modality: "Online / Presencial", price: "450 €" },
};

// Curso seleccionado: primero los B2C de src/content/cursos, después los B2B
const cursoB2C = courseId ? await getCurso(courseId) : undefined;
const selectedCourse: CursoB2B | null = cursoB2C
  ? await datosInscripcion(cursoB2C)
  : (cursosB2B[courseId] ?? null);

// Desplegable: cursos B2C visibles (y el seleccionado aunque esté oculto) + B2B
const cursosVisibles = await getCursos();
if (cursoB2C && !cursoB2C.visible) cursosVisibles.push(cursoB2C);
const courses = [
  ...cursosVisibles.map((c) => ({ id: c.id, name: c.nombre })),
  ...Object.values(cursosB2B).map((c) => ({ id: c.id, name: c.name })),
];

// Course card data (only if course is selected)
const courseCardData = selectedCourse
  ? {
      title: selectedCourse.name,
      description: selectedCourse.description,
      image: selectedCourse.image,
      items: [
        {
          icon: "Calendar",
          label: "Inicio",
          value: selectedCourse.startDate,
        },
        {
          icon: "Clock",
          label: "Duración",
          value: selectedCourse.duration,
        },
        {
          icon: "Globe",
          label: "Modalidad",
          value: selectedCourse.modality,
        },
      ],
      footer: {
        label: "Precio",
        subValue: selectedCourse.priceSubtext, 
        value: selectedCourse.price,
        previousValue: selectedCourse.previousPrice,
        discountText: selectedCourse.formerStudentDiscount, 
      },
    }
  : null;
---

<Layout title={enrollmentType === "interest" ? "Me interesa el curso - Qualisophy" : "Inscripción a Cursos - Qualisophy"}>
  <div class="min-h-screen bg-gradient-to-b to-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      
      {/* BREADCRUMBS DINÁMICOS */}
      <nav class="text-sm text-slate-500 mb-8 flex flex-wrap items-center">
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <span class="mx-2 text-slate-400">/</span>
        <a href="/cursos" class="hover:text-primary transition-colors">Cursos</a>
        
        {selectedCourse?.categoryUrl && (
          <>
            <span class="mx-2 text-slate-400">/</span>
            <a href={selectedCourse.categoryUrl} class="hover:text-primary transition-colors">
              {selectedCourse.categoryName}
            </a>
          </>
        )}
        
        {selectedCourse?.courseUrl && (
          <>
            <span class="mx-2 text-slate-400">/</span>
            <a href={selectedCourse.courseUrl} class="hover:text-primary transition-colors truncate max-w-[200px] sm:max-w-xs">
              {selectedCourse.name}
            </a>
          </>
        )}

        <span class="mx-2 text-slate-400">/</span>
        <span class="text-slate-800 font-medium">
          {enrollmentType === "interest" ? "Me interesa" : "Inscripción"}
        </span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class:list={[courseCardData ? "lg:col-span-2" : "lg:col-span-3"]}>
          <h1
            class="text-2xl md:text-3xl lg:text-4xl font-bold mb-2 text-slate-800"
          >
            {enrollmentType === "interest" ? "Me interesa este curso" : "Inscripción al Curso"}
          </h1>
          <p class="text-slate-600 mb-8">
            {enrollmentType === "interest" 
              ? "Déjanos tus datos para ser el primero en enterarte cuando abramos plazas o confirmemos fechas."
              : "Estás a un paso de comenzar tu aprendizaje. Completa tus datos para reservar tu plaza."}
          </p>
          <CourseEnrollmentForm 
            client:load 
            courses={courses} 
            initialCourseId={courseId} 
            enrollmentType={enrollmentType}
          />
        </div>

        {
          courseCardData && (
            <div class="lg:col-span-1">
              <InstructorCard
                client:load
                title={courseCardData.title}
                description={courseCardData.description}
                image={courseCardData.image}
                items={courseCardData.items}
                footer={courseCardData.footer}
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>