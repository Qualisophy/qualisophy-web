---
import Layout from "@/layouts/Layout.astro";
import { MigrantTalentContent } from "@/components/react/programs/MigrantTalentContent";

import { getLangFromUrl, useTranslations } from "@/i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout 
  title={t("migrant.meta.title")} 
  description={t("migrant.meta.desc")} 
  fullWidth={true}
>
  <MigrantTalentContent client:load />
</Layout>