---
import Layout from "@/layouts/Layout.astro";
import { ContactContent } from "@/components/react/contact/ContactContent";
import { Breadcrumbs } from "@/components/react/shared/Breadcrumbs";
import { ViewTransitions } from "astro:transitions";

// Importamos el hook de traducciones de Astro solo para los metadatos SEO
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("contact.meta.title")}
  description={t("contact.meta.desc")}
>
  <ViewTransitions />
  
  <div class="mb-6">
    <Breadcrumbs client:load pathname={Astro.url.pathname} />
  </div>

  <ContactContent client:load />

</Layout>