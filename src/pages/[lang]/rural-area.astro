---
import Layout from "@/layouts/Layout.astro";

// Importación de Componentes de Programas
import { ProgramHero } from "@/components/react/programs/ProgramHero";
import { ProgramMethodology } from "@/components/react/programs/ProgramMethodology";
import { ProgramFeatures } from "@/components/react/programs/ProgramFeatures";
import { ProgramCurriculum } from "@/components/react/programs/ProgramCurriculum";
import { ProgramCTA } from "@/components/react/programs/ProgramCTA";

// Importación de Componentes de Talento y Mapa
import { TalentReality } from "@/components/react/talent/TalentReality";
import { TalentBarriers } from "@/components/react/talent/TalentBarriers";
import { TalentImpact } from "@/components/react/talent/TalentImpact";
import { LegalCompliance } from "@/components/react/talent/LegalCompliance";
import { SocialImpactQuote } from "@/components/react/talent/SocialImpactQuote";
import { SpainMap } from "@/components/react/talent/SpainMap"; 

// Importación de imágenes locales
import talentImactImg from "@/assets/pages/rural-area/talent-impact.jpeg";

// 1. IMPORTAMOS DATOS
import { es } from "@/data/pages/rural-area/es";
import { fr } from "@/data/pages/rural-area/fr";

// 2. RUTAS DINÁMICAS
export function getStaticPaths() {
  return [ { params: { lang: 'es' } }, { params: { lang: 'fr' } } ];
}

// 3. IDIOMA ACTUAL Y DATOS
const { lang } = Astro.params;
const content = lang === 'fr' ? fr : es;

const ctaButtons = [
  { label: content.cta.btn1, href: "/contact?type=company-rural", variant: "solid" as const },
  { label: content.cta.btn2, href: "/contact?type=candidate-rural", variant: "outline" as const }
];
---

<Layout 
  title={content.meta.title}
  description={content.meta.description}
  fullWidth={true}
>
  
  <ProgramHero 
    client:load
    title={content.hero.title} 
    highlight={content.hero.highlight}
    subtitle={content.hero.subtitle}
    backgroundImage="https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=2000&auto=format&fit=crop"
    ctaText={content.hero.ctaText}
    scrollToId="realidad-territorial"
  />

  <div id="realidad-territorial" class="scroll-mt-20">
    <TalentReality 
      client:load 
      title={content.reality.title}
      subtitle={content.reality.subtitle}
      description={content.reality.description}
      stats={content.reality.stats} 
    />
  </div>

  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-stretch">
        
        <div class="flex flex-col gap-8 h-full justify-center">
          <div>
            <h2 class="text-3xl font-heading sm:text-4xl font-bold text-secondary mb-6">
              {content.espanaVaciada.title}
            </h2>
            <p class="text-lg text-slate-600 font-primary leading-relaxed mb-4">
              {content.espanaVaciada.p1}
            </p>
            <p class="text-lg text-slate-600 font-primary leading-relaxed">
              {content.espanaVaciada.p2}
            </p>
          </div>
          
          <div class="grid sm:grid-cols-2 gap-6 mt-4">
            {content.espanaVaciada.features.map((item) => (
              <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3 text-primary">
                  <span class="material-symbols-outlined">{item.icon}</span>
                </div>
                <h4 class="font-bold text-secondary text-lg mb-2">{item.title}</h4>
                <p class="text-sm text-slate-600">{item.description}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="w-full h-full flex flex-col justify-center min-h-[500px]">
           <SpainMap client:load />
        </div>
      </div>
    </div>
  </section>

  <div class="bg-white">
    <TalentBarriers 
      client:load 
      title={content.barriers.title}
      barriers={content.barriers.items} 
      layout="grid2"
    />
  </div>

  <TalentImpact 
    client:load 
    title={content.impact.title}
    subtitle={content.impact.subtitle}
    items={content.impact.items} 
    imageSrc={talentImactImg.src}
  />

  <div class="bg-white border-t border-gray-50">
    <LegalCompliance 
      client:load 
      title={content.legal.title}
      items={content.legal.items} 
      footerText={content.legal.footerText}
      footerSize="large"
    />
  </div>

  <ProgramMethodology 
    client:visible
    title={content.strategy1.title}
    description={content.strategy1.description}
    checks={content.strategy1.checks}
    imageSrc="https://images.unsplash.com/photo-1544377193-33dcf4d68fb5?q=80&w=2000&auto=format&fit=crop"
    variant="blue" 
  />

  <ProgramFeatures 
    client:visible
    title={content.strategy2.title}
    subtitle={content.strategy2.subtitle}
    features={content.strategy2.features}
    variant="light"  
    layout="grid4" 
  />

  <ProgramCurriculum 
    client:visible
    title={content.curriculum.title}
    subtitle={content.curriculum.subtitle}
    steps={content.curriculum.steps}
    variant="blue" 
  />

  <div class="bg-white border-b border-gray-100">
    <SocialImpactQuote 
      client:load 
      title={content.quote.title}
      subtitle={content.quote.subtitle}
      pillars={content.quote.pillars}
      quoteText={content.quote.quoteText}
      quoteHighlight={content.quote.quoteHighlight}
      quoteEnd={content.quote.quoteEnd}
    />
  </div>

  <div id="program-cta">
    <ProgramCTA 
      client:visible 
      variant="white"
      title={content.cta.title}
      description={content.cta.description}
      buttons={ctaButtons}
    />
  </div>

</Layout>