---
// src/pages/[lang]/index.astro
import Layout from "@/layouts/Layout.astro";

// Le decimos a Astro qué idiomas tiene que generar
export function getStaticPaths() {
  return [ { params: { lang: 'es' } }, { params: { lang: 'fr' } } ];
}
const { lang } = Astro.params;

// Componentes React
import { HeroSection } from "@/components/react/home/HeroSection";
import { AboutSection } from "@/components/react/home/AboutSection";
import { MissionSection } from "@/components/react/home/MissionSection";
import { InclusionPillars } from "@/components/react/home/InclusionPillars";
import { ValuesSection } from "@/components/react/home/ValuesSection";
import { Newsletter } from "@/components/react/shared/Newsletter";

// Importamos los datos
import { es } from "@/data/pages/index/es";
import { fr } from "@/data/pages/index/fr";
const content = lang === 'fr' ? fr : es;
---

<Layout 
  title={content.meta.title}
  description={content.meta.description}
  fullWidth={true} 
>
  <HeroSection client:load data={content.hero} />
  <AboutSection data={content.about} />
  <MissionSection data={content.mission} />
  <ValuesSection data={content.values} />
  <InclusionPillars client:visible data={content.pillars} />
  <Newsletter client:visible variant="white" data={content.newsletter} />
</Layout>