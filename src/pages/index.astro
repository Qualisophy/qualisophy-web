---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets"; // AÑADIDO
import top50Badge from "@/assets/top-50.png"; // AÑADIDO

// Componentes React
import { HeroSection } from "@/components/react/home/HeroSection";
import { AboutSection } from "@/components/react/home/AboutSection";
import { MissionSection } from "@/components/react/home/MissionSection";
import { InclusionPillars } from "@/components/react/home/InclusionPillars";
import { ValuesSection } from "@/components/react/home/ValuesSection";
import { Newsletter } from "@/components/react/shared/Newsletter";
---

<Layout 
  title="Qualisophy - Inclusión Tecnológica" 
  fullWidth={true} 
>
  
  {/* 1. HERO (Imagen Completa) */}
  <HeroSection client:load />

{/* --- WIDGET FLOTANTE TOP 50 --- */}
  <a 
    id="floating-badge" 
    href="/blog/qualisophy-top-50"
    class="fixed bottom-24 left-4 md:bottom-28 md:left-8 z-[100] transition-all duration-500 ease-in-out opacity-100 translate-y-0 block"
    title="Leer más sobre nuestro reconocimiento en el Top 50 Emprendedores de Andalucía"
  >
    <Image
      src={top50Badge}
      alt="Reconocimiento Top 50 Emprendedores Andalucía"
      width={120}
      height={120}
      format="webp"
      class="w-16 md:w-20 lg:w-24 h-auto object-contain drop-shadow-2xl hover:scale-110 transition-transform duration-300"
    />
  </a>

  {/* 2. IDENTIDAD / QUIÉNES SOMOS (Fondo Blanco - Imagen Izquierda) */}
  <AboutSection />

  {/* 3. MISIÓN / OBJETO SOCIAL (Fondo Blanco - Imagen Derecha) */}
  <MissionSection />

  {/* 4. VALORES (Fondo Gris Claro) */}
  <ValuesSection />

  {/* 5. PILARES (Fondo Blanco) */}
  <InclusionPillars client:visible />

  {/* 6. NEWSLETTER (Fondo Blanco) */}
  <Newsletter client:visible variant="white" />

</Layout>

{/* --- SCRIPT PARA MOSTRAR/OCULTAR EL WIDGET --- */}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const heroSection = document.getElementById('hero-section');
    const badge = document.getElementById('floating-badge');

    if (!heroSection || !badge) return;

    // Usamos IntersectionObserver para detectar si el Hero es visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // El Hero es visible: Aparece el sello (sube a su sitio y opacidad al 100%)
          badge.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-8');
          badge.classList.add('opacity-100', 'translate-y-0');
        } else {
          // El Hero ya no es visible: Desaparece el sello (baja ligeramente y opacidad al 0%)
          badge.classList.add('opacity-0', 'pointer-events-none', 'translate-y-8');
          badge.classList.remove('opacity-100', 'translate-y-0');
        }
      });
    }, {
      threshold: 0.1 // Reacciona en cuanto un 10% del Hero entra o sale de la pantalla
    });

    observer.observe(heroSection);
  });
</script>