---
import Layout from "@/layouts/Layout.astro";
import { FAQSection } from "@/components/react/shared/FAQSection";
import { faqMap, type FaqSlug, faqTitles } from "@/data/faqs/index";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { ParticleMeshBackground } from "@/components/react/shared/ParticleMeshBackground";

export async function getStaticPaths() {
  return Object.keys(faqMap).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// 1. Verificación estricta: si el slug no existe en nuestro mapa, no renderizamos la página
if (!slug || !(slug in faqMap)) {
  return Astro.redirect('/404'); 
}

const currentSlug = slug as FaqSlug;
const faqs = faqMap[currentSlug];

const title = faqTitles[currentSlug];
---

<Layout
  title={`${title} - Qualisophy`}
  description="Resuelve todas tus dudas sobre nuestros programas de inclusión y formación."
>
  <div class="relative w-full bg-white overflow-hidden min-h-screen pb-12">
    
    <div class="absolute inset-0 z-0 opacity-60 pointer-events-none">
      <ParticleMeshBackground client:load />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-8">
      <Breadcrumbs />
    </div>

    <div class="relative z-10">
      {/* Usamos el faqs que ahora sabemos con seguridad que existe */}
      <FAQSection client:load faqs={faqs} key={currentSlug} />
    </div>
    
  </div>
</Layout>