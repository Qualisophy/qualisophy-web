---
import Layout from "@/layouts/Layout.astro";
import { Course } from "@/components/react/course/Course";
import { EnrollButton } from "@/components/react/shared/EnrollButton";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

// Imagen del curso (redes sociales) e imagen del instructor
import courseImg from "@/assets/imagenes-cursos/reconversion/triunfa-en-tu-reconversion-laboral.jpeg";
import instructorImg from "@/assets/instructor/instructor-fran.png";

const seoDescription =
  "Curso online para dar el salto a QA: CV estratégico, LinkedIn, portfolio y entrevistas con mentoría 1 a 1. Empieza el 15 de enero de 2027.";

const courseDescription =
  "Cambiar de sector no es fácil: muchas personas que saben testear o que vienen de otra área se quedan atascadas en los procesos de selección. El problema no suele ser la falta de capacidad, sino un CV que no destaca, un perfil de LinkedIn invisible para los reclutadores, la falta de un portfolio que demuestre lo que sabes y entrevistas para las que nadie te ha preparado.";

const whatIsAbout =
  "En esta formación trabajamos esos cuatro pilares (CV estratégico, LinkedIn SEO, Portfolio QA y Entrevistas) en tres fases: Estrategia, Optimización y Acción. Con una clase online intensiva, una mentoría 1 a 1 y un simulacro de entrevista, sales con tu candidatura lista para optar a tu primer puesto en QA.";

const job =
  "La formación te prepara para optar a puestos de QA Tester o QA Junior con una candidatura sólida. Te damos herramientas y acompañamiento, pero no garantizamos un empleo.";

const prerequisites =
  "Dirigido a personas que ya saben testear y buscan su primer puesto en QA, y a quienes vienen de otra área y quieren dar el salto a la tecnología. No hace falta experiencia previa en programación.";

// Los 4 pilares repartidos en las 3 fases (Estrategia → Optimización → Acción)
const modules = [
  {
    id: "1",
    number: 1,
    title: "Fase 1 · Estrategia: tu punto de partida",
    description: "Definimos hacia dónde vas antes de tocar tu candidatura.",
    topics: [
      "Análisis de tu perfil y de tus competencias transferibles.",
      "Qué buscan las empresas al contratar perfiles QA.",
      "Elección del puesto objetivo: QA Tester o QA Junior.",
      "Plan de acción personalizado para tu reconversión.",
    ],
    icon: "BookOpen",
  },
  {
    id: "2",
    number: 2,
    title: "Fase 2 · Optimización: CV estratégico",
    description: "Un CV que pone en valor tu experiencia previa.",
    topics: [
      "Estructura y enfoque de un CV para perfiles QA.",
      "Cómo traducir tu experiencia anterior a competencias de calidad.",
      "Palabras clave para superar los filtros de selección (ATS).",
      "Revisión de tu CV en la mentoría 1 a 1.",
    ],
    icon: "BookOpen",
  },
  {
    id: "3",
    number: 3,
    title: "Fase 2 · Optimización: LinkedIn SEO",
    description: "Que los reclutadores te encuentren.",
    topics: [
      "Titular, extracto y experiencia orientados a QA.",
      "Palabras clave que buscan los reclutadores.",
      "Aptitudes, recomendaciones y actividad en la red.",
      "Revisión de tu perfil en la mentoría 1 a 1.",
    ],
    icon: "BookOpen",
  },
  {
    id: "4",
    number: 4,
    title: "Fase 2 · Optimización: Portfolio QA",
    description: "Demuestra lo que sabes hacer con ejemplos reales.",
    topics: [
      "Qué incluir en un portfolio de QA.",
      "Casos de prueba, reportes de defectos y ejemplos prácticos.",
      "Cómo presentar tu portfolio en el CV y en LinkedIn.",
    ],
    icon: "Code",
  },
  {
    id: "5",
    number: 5,
    title: "Fase 3 · Acción: Entrevistas",
    description: "Llega preparado a los procesos de selección.",
    topics: [
      "Preguntas técnicas y de comportamiento más habituales en QA.",
      "Cómo contar tu historia de reconversión.",
      "Simulacro de entrevista de 1 h con feedback personalizado.",
      "Plan para lanzar tus candidaturas.",
    ],
    icon: "Zap",
  },
];

const instructor = {
  name: "Fran Guerrero",
  title: "Instructor Tech · Aseguramiento de Calidad",
  experience: "Más de 15 años de experiencia en QA",
  description:
    "Especialista en aseguramiento de calidad que conoce de primera mano qué buscan las empresas al contratar perfiles de QA y cómo preparar una candidatura para conseguirlo.",
  image: instructorImg.src,
  certifications: ["ISTQB Agile Tester", "ISTQB Foundation Level", "GenAI ISTQB"],
};

// TODO: duraciones provisionales (placeholder) hasta confirmarlas
// [Pendiente de revisión legal] textos de precio y garantía
const courseDetails = {
  startDate: "15 de enero de 2027",
  modality: "Online",
  duration: "Clase online intensiva (3 h), mentoría 1 a 1 (1 h) y simulacro de entrevista (1 h)",
  schedule: "18:00 - 21:00",
  regularPrice: "100 € (valor real 125 €)",
  earlyBirdPrice: "",
  guarantee: "Devolución del 100 % de la matrícula si firmas un contrato como QA",
  oldStudentsDiscount: "Precio para antiguos alumnos: 80 € (20 % extra)",
  offerText: "Oferta exclusiva por tiempo limitado",
};

// [Pendiente de revisión legal] respuesta sobre la garantía
const faqs = [
  {
    question: "¿Cuánto cuesta?",
    answer:
      "100 € de lanzamiento (valor real de 125 €). Los antiguos alumnos pagan 80 €, con un 20 % extra. Oferta exclusiva por tiempo limitado.",
  },
  {
    question: "¿Cuándo empieza?",
    answer: "El 15 de enero de 2027, en modalidad online.",
  },
  {
    question: "¿Qué garantía tiene?",
    answer:
      "Si firmas un contrato como QA, devolvemos el 100 % de tu matrícula. Para tenerla debes asistir a las clases y mentorías, aplicar las mejoras en tu CV y LinkedIn, y enviarnos la confirmación del contrato.",
  },
  {
    question: "¿A quién va dirigido?",
    answer:
      "A personas que ya saben testear y buscan su primer puesto en QA, y a quienes vienen de otra área y quieren dar el salto a la tecnología. La formación ofrece herramientas y acompañamiento; no garantiza un empleo.",
  },
];

const courseId = "reconversion-triunfa";
const courseName = "Triunfa en tu reconversión laboral";
---

<Layout
  title={`${courseName} - Qualisophy`}
  description={seoDescription}
  image={courseImg.src}
  fullWidth={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6"><Breadcrumbs /></div>
    <h1 class="text-center text-2xl md:text-3xl font-bold text-slate-800 mb-8 md:mb-16">
      {courseName}
    </h1>
    <Course
      client:load
      modules={modules}
      instructor={instructor}
      courseDetails={courseDetails}
      courseId={courseId}
      courseDescription={courseDescription}
      whatIsAbout={whatIsAbout}
      job={job}
      prerequisites={prerequisites}
      faqs={faqs}
    />
    <EnrollButton
      client:load
      courseId={courseId}
      courseName={courseName}
      isComingSoon={courseDetails.startDate.toLowerCase().includes("por definir")}
    />
  </div>
</Layout>
