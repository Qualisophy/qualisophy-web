---
import Layout from "@/layouts/Layout.astro";
import { ProgramHero } from "@/components/react/programs/ProgramHero";
import { CourseGridCard } from "@/components/react/course/CourseGridCard";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

// Imagen propia del curso para compartir en redes (OG). El hero usa Unsplash como placeholder.
import heroImg from "@/assets/imagenes-cursos/reconversion/triunfa-en-tu-reconversion-laboral.jpeg";
import { getTarjetasCategoria } from "@/lib/cursos";

// Cursos de esta categoría (src/content/cursos/reconversion-laboral/)
const courses = await getTarjetasCategoria("reconversion-laboral");
---

<Layout
  title="Cursos de Reconversión Laboral - Qualisophy"
  description="Formación para dar el salto al sector tecnológico: CV, LinkedIn, portfolio y entrevistas para conseguir tu primer puesto en QA."
  image={heroImg.src}
  fullWidth={true}
>
  <ProgramHero
    client:load
    title="Formación en"
    highlight="Reconversión Laboral"
    subtitle="Da el salto al sector tecnológico. Te ayudamos a preparar tu candidatura y a afrontar los procesos de selección para tu primer puesto en QA."
    backgroundImage="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&fit=crop&q=80"
    ctaText="Ver cursos"
    scrollToId="courses-grid"
  />

  <div class="bg-gray-50/50 min-h-screen">
    <div class="container mx-auto px-6 pt-8 pb-4">
        <Breadcrumbs />
    </div>

    <section id="courses-grid" class="py-12 pb-24">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4 border-b border-gray-200 pb-6">
                <div class="max-w-2xl">
                    <h2 class="text-3xl font-bold font-heading text-secondary mb-2">Impulsa tu cambio profesional</h2>
                    <p class="text-gray-600 font-primary">Formaciones prácticas y con acompañamiento para convertir tu experiencia en una nueva carrera tecnológica.</p>
                </div>
                <div class="hidden md:block text-sm text-gray-400 font-medium">Mostrando {courses.length} cursos</div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                {courses.map((course) => (
                <CourseGridCard
                    client:visible
                    title={course.title}
                    description={course.description}
                    imageSrc={course.image}
                    href={course.href}
                    level={course.level}
                    duration={course.duration}
                    modality={course.modality}
                    category={course.categoryName}
                />
                ))}
            </div>
        </div>
    </section>
  </div>
</Layout>
