---
import Layout from "@/layouts/Layout.astro";
import { Course } from "@/components/react/course/Course";
import { EnrollButton } from "@/components/react/shared/EnrollButton";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

const courseDescription = "El control de versiones es una habilidad esencial en el desarrollo moderno. Este curso básico de Git, basado en la filosofía learning by doing, introduce a los estudiantes en el uso práctico de Git para gestionar cambios en el código, trabajar con ramas, realizar commits efectivos y colaborar en equipo de forma profesional. Ideal para iniciarse en entornos de desarrollo reales y mejorar la productividad desde el primer día.";

const prerequisites = "Estar familiarizado con la terminal y/o algún editor de código.";

const modules = [
  {
    id: "1",
    number: 1,
    title: "Introducción a Git y Control de Versiones",
    description: "Comprende los fundamentos de Git y cómo gestionar el historial de cambios.",
    topics: [
      "Qué es el control de versiones y por qué Git es el estándar en desarrollo moderno.",
      "Inicialización de repositorios, estructura básica y primeros commits.",
      "Configuración inicial de usuario, flujo básico de trabajo y uso de repositorios remotos."
    ],
    icon: "GitBranch",
  },
  {
    id: "2",
    number: 2,
    title: "Ramas, Fusiones y Trabajo Colaborativo",
    description: "Aprende a trabajar en paralelo con ramas y equipos.",
    topics: [
      "Creación y gestión de ramas para desarrollo de funcionalidades independientes.",
      "Estrategias de merge y resolución de conflictos entre cambios.",
      "Uso de repositorios remotos para colaboración y sincronización de cambios."
    ],
    icon: "GitMerge",
  },
  {
    id: "3",
    number: 3,
    title: "Historial, Deshacer Cambios y Control Avanzado",
    description: "Domina el control del historial y la recuperación de cambios.",
    topics: [
      "Exploración del historial de commits y navegación entre versiones.",
      "Uso de reset, revert y checkout para deshacer cambios de forma segura.",
      "Gestión de etiquetas (tags) y almacenamiento temporal con stash."
    ],
    icon: "History",
  },
  {
    id: "4",
    number: 4,
    title: "Flujos de Trabajo Avanzados y Proyecto Final",
    description: "Consolida tus conocimientos aplicando Git en proyectos reales.",
    topics: [
      "Modelos de trabajo como Git Flow y GitHub Flow aplicados a proyectos reales.",
      "Hooks de Git y automatización de tareas locales.",
      "Proyecto final integrador con flujo completo de desarrollo y colaboración."
    ],
    icon: "Workflow",
  }
];

const courseDetails = {
  startDate: "Por definir",
  duration: "Por definir",
  schedule: "Por definir",
  regularPrice: "Por definir",
  earlyBirdPrice: "Por definir", 
};

const courseId = "devops-git";
const courseName = "Control de Versiones con Git";
---

<Layout title={`${courseName} - Qualisophy`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6"><Breadcrumbs /></div>
    <h1 class="text-center text-2xl md:text-3xl font-bold text-slate-800 mb-8 md:mb-16">
      {courseName}
    </h1>
    <Course 
      client:load 
      modules={modules} 
      instructor={null} 
      courseDetails={courseDetails} 
      courseId={courseId}
      courseDescription={courseDescription}
      prerequisites={prerequisites}
    />
    <EnrollButton 
      client:load 
      courseId={courseId} 
      courseName={courseName} 
      isComingSoon={courseDetails.startDate.toLowerCase().includes("por definir")}
    />
  </div>
</Layout>