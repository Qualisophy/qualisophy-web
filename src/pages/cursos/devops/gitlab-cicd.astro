---
import Layout from "@/layouts/Layout.astro";
import { GitlabCicdContent } from "@/components/react/course/GitlabCicdContent";
import { getLangFromUrl, useTranslations } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const courseName = t("course.devops-gitlab.name" as any) || "Gestión Avanzada y CI/CD con GitLab";
---

<Layout title={`${courseName} - Qualisophy`}>
  <GitlabCicdContent client:load pathname={Astro.url.pathname} />
</Layout>