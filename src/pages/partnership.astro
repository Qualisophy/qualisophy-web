---
import Layout from "@/layouts/Layout.astro";
import { PartnershipContent } from "@/components/react/partnership/PartnershipContent";
import { getLangFromUrl, useTranslations } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout 
  title={t("partnership.meta.title")}
  description={t("partnership.meta.desc")}
  fullWidth={true}
>
  <PartnershipContent client:load />
</Layout>